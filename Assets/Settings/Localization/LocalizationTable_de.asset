  - m_Id: 19378006496632832
    m_Localized: "Neue Version von Nexus Meta Club verf\xFCgbar"
    m_Metadata:
      m_Items: []
  - m_Id: 19378221098196992
    m_Localized: Update herunterladen
    m_Metadata:
      m_Items: []
  - m_Id: 19378917855977472
    m_Localized: "Update verf\xFCgbar"
    m_Metadata:
      m_Items: []
  - m_Id: 19381198005460992
    m_Localized: "Aufl\xF6sung der Sprachaufzeichnung"
    m_Metadata:
      m_Items: []
  - m_Id: 19381198680743936
    m_Localized: "F\xFCr den Sprachchat ist die Berechtigung zur Sprachaufzeichnung
      erforderlich. Erlauben Sie die Mikrofonnutzung im Pop-up-Fenster."
    m_Metadata:
      m_Items: []
  - m_Id: 19381199368609792
    m_Localized: "Sie haben die Nutzung Ihres Mikrofons blockiert. Um den Sprachchat
      zu aktivieren, gehen Sie wie folgt vor: \xD6ffnen Sie die Einstellungen, suchen
      Sie nach Nexus Meta Club, w\xE4hlen Sie Berechtigungen und aktivieren Sie die
      Mikrofonberechtigung."
    m_Metadata:
      m_Items: []
  - m_Id: 19381200492683264
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 19381279727280128
    m_Localized: Nicht
    m_Metadata:
      m_Items: []
  - m_Id: 19381444580204544
    m_Localized: "Bu\xDFgeld"
    m_Metadata:
      m_Items: []
  - m_Id: 19418267023024128
    m_Localized: "Das Eingabefeld f\xFCr die Telefonnummer ist leer"
    m_Metadata:
      m_Items: []
  - m_Id: 19418500847083520
    m_Localized: Es ist ein Fehler aufgetreten
    m_Metadata:
      m_Items: []
  - m_Id: 19418631407378432
    m_Localized: Es ist ein unbekannter Fehler aufgetreten. Bitte starten Sie die
      App neu oder kontaktieren Sie den Support.
    m_Metadata:
      m_Items: []
  - m_Id: 19418774697385984
    m_Localized: Anfragefehler
    m_Metadata:
      m_Items: []
  - m_Id: 19435281443692544
    m_Localized: "Ung\xFCltiges Telefonnummernformat. Erwartet werden 10\u201315
      Ziffern, inklusive L\xE4ndervorwahl, ohne Pluszeichen."
    m_Metadata:
      m_Items: []
  - m_Id: 19435311844007936
    m_Localized: "Ung\xFCltiges Benutzernamenformat. Erwartet werden 5-15 Zeichen,
      nur Buchstaben, Zahlen und Unterstriche."
    m_Metadata:
      m_Items: []
  - m_Id: 19435382325092352
    m_Localized: "Ung\xFCltiger Best\xE4tigungscode"
    m_Metadata:
      m_Items: []
  - m_Id: 19435422800125952
    m_Localized: Der Benutzername ist bereits vergeben
    m_Metadata:
      m_Items: []
  - m_Id: 19435442706292736
    m_Localized: Diese Telefonnummer ist bereits vergeben
    m_Metadata:
      m_Items: []
  - m_Id: 19435501460103168
    m_Localized: Authentifizierungsfehler
    m_Metadata:
      m_Items: []
  - m_Id: 19435521957666816
    m_Localized: Benutzer nicht gefunden
    m_Metadata:
      m_Items: []
  - m_Id: 19435546137829376
    m_Localized: Ihr Konto wurde dauerhaft gesperrt
    m_Metadata:
      m_Items: []
  - m_Id: 19435564290777088
    m_Localized: 'Ihr Konto ist bis zu diesem Datum gesperrt:'
    m_Metadata:
      m_Items: []
  - m_Id: 19435582074626048
    m_Localized: Fehler im externen Dienst
    m_Metadata:
      m_Items: []
  - m_Id: 19435630443339776
    m_Localized: "Der Empfang eines SMS-Best\xE4tigungscodes ist in Ihrem Land nicht
      m\xF6glich"
    m_Metadata:
      m_Items: []
  - m_Id: 19435678971437056
    m_Localized: Zu viele Anfragen
    m_Metadata:
      m_Items: []
  - m_Id: 19435707538841600
    m_Localized: "Anfragelimit \xFCberschritten. Bitte versuchen Sie es in wenigen
      Sekunden erneut"
    m_Metadata:
      m_Items: []
  - m_Id: 20937129000427520
    m_Localized: "Wir haben festgestellt, dass einige Spieledienste in Ihrer Region
      m\xF6glicherweise nicht verf\xFCgbar sind. F\xFCr einen reibungslosen Betrieb
      aller Funktionen und ein optimales Spielerlebnis empfehlen wir die Verwendung
      einer VPN-Verbindung"
    m_Metadata:
      m_Items: []
  - m_Id: 20937122172100608
    m_Localized: Zugang zu Diensten
    m_Metadata:
      m_Items: []
  - m_Id: 34051568226435072
    m_Localized: Serverauswahl
    m_Metadata:
      m_Items: []
  - m_Id: 34051579672690688
    m_Localized: Warten auf Server
    m_Metadata:
      m_Items: []
